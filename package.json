{
  "name": "@terranc/magpick",
  "version": "0.1.1",
  "description": "Session-scoped model picker for the Magpie gateway (Claude Code + Codex)",
  "type": "module",
  "bin": {
    "magpick": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "magpie",
    "claude",
    "claude-code",
    "codex",
    "gateway",
    "model",
    "provider",
    "cli",
    "anthropic",
    "openai"
  ],
  "author": "TerranChao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terranc/magpick.git"
  },
  "bugs": {
    "url": "https://github.com/terranc/magpick/issues"
  },
  "homepage": "https://github.com/terranc/magpick#readme",
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.14",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
